# Copy to .env (gitignored) and fill in.
ANTHROPIC_API_KEY=
# Optional: escalations are logged instead when unset.
SLACK_WEBHOOK_URL=
# Optional: from your Slack app's Basic Information page; needed for the Approve/Reject buttons.
SLACK_SIGNING_SECRET=
# Optional: shared secret Zendesk sends in the X-Webhook-Secret header.
ZENDESK_WEBHOOK_SECRET=
# Optional: Zendesk API access for write-backs.
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
ZENDESK_AUTO_SEND=false
# Required for POST /tickets (each call costs LLM money). Generate: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
TRIAGE_API_TOKEN=
